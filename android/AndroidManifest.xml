<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.storyteller.vectorcraft"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">

    <!-- Web links in documents and the update check. Files are opened and saved through the system
         file picker, so no storage permission is needed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="VectorCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name="ai.storyteller.vectorcraft.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="vectorcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
